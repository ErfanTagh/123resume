          },
          "expr": "topk(10, sum by (route) ((((resume_http_requests_total unless resume_http_requests_total offset $__range) + 0) or increase(resume_http_requests_total[$__range]))))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
